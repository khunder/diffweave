<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiffWeave.App.ViewModels"
        xmlns:v="using:DiffWeave.App.Views"
        xmlns:d="using:DiffWeave.App.Documents"
        x:Class="DiffWeave.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DiffWeave" Width="1280" Height="820" MinWidth="640" MinHeight="400"
        AutomationProperties.Name="DiffWeave">
  <Window.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Border.sep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Background" Value="{DynamicResource DW.Pane.Border}" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DW.Badge.Foreground}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource DW.Status.Foreground}" />
    </Style>
  </Window.Styles>
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFilesDialogCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding FindCommand}" />
    <KeyBinding Gesture="Ctrl+G" Command="{Binding GoToLineCommand}" />
    <KeyBinding Gesture="Ctrl+Up" Command="{Binding PreviousDifferenceCommand}" />
    <KeyBinding Gesture="Ctrl+Down" Command="{Binding NextDifferenceCommand}" />
    <KeyBinding Gesture="Ctrl+Home" Command="{Binding FirstDifferenceCommand}" />
    <KeyBinding Gesture="Ctrl+End" Command="{Binding LastDifferenceCommand}" />
    <KeyBinding Gesture="Ctrl+PageUp" Command="{Binding PreviousConflictCommand}" />
    <KeyBinding Gesture="Ctrl+PageDown" Command="{Binding NextConflictCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding ChooseACommand}" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding ChooseBCommand}" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding ChooseCCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+M" Command="{Binding AutoMergeAllCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomFontCommand}" CommandParameter="+" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomFontCommand}" CommandParameter="-" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomFontCommand}" CommandParameter="0" />
  </Window.KeyBindings>
  <DockPanel>
    <Menu DockPanel.Dock="Top" x:Name="MainMenu">
      <MenuItem Header="_File">
        <MenuItem Header="_Compare Files…" InputGesture="Ctrl+O" Command="{Binding OpenFilesDialogCommand}" />
        <MenuItem Header="_Merge Files…" Command="{Binding OpenMergeDialogCommand}" />
        <MenuItem Header="Compare _Directories…" Command="{Binding OpenDirectoriesDialogCommand}" />
        <MenuItem Header="_Recent" x:Name="RecentMenu" />
        <Separator />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <MenuItem Header="Save _As…" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <MenuItem Header="Re_load" InputGesture="F5" Command="{Binding ReloadCommand}" />
        <Separator />
        <MenuItem Header="_Close Tab" InputGesture="Ctrl+W" Command="{Binding CloseTabCommand}" CommandParameter="{x:Null}" />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem Header="Cu_t" InputGesture="Ctrl+X" Command="{Binding CutCommand}" />
        <MenuItem Header="_Copy" InputGesture="Ctrl+C" Command="{Binding CopyCommand}" />
        <MenuItem Header="_Paste" InputGesture="Ctrl+V" Command="{Binding PasteCommand}" />
        <MenuItem Header="Select _All" InputGesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
        <Separator />
        <MenuItem Header="_Find…" InputGesture="Ctrl+F" Command="{Binding FindCommand}" />
        <MenuItem Header="_Go to Line…" InputGesture="Ctrl+G" Command="{Binding GoToLineCommand}" />
      </MenuItem>
      <MenuItem Header="_Diff">
        <MenuItem Header="_Previous Difference" InputGesture="Ctrl+Up" Command="{Binding PreviousDifferenceCommand}" />
        <MenuItem Header="_Next Difference" InputGesture="Ctrl+Down" Command="{Binding NextDifferenceCommand}" />
        <MenuItem Header="_First Difference" InputGesture="Ctrl+Home" Command="{Binding FirstDifferenceCommand}" />
        <MenuItem Header="_Last Difference" InputGesture="Ctrl+End" Command="{Binding LastDifferenceCommand}" />
        <Separator />
        <MenuItem Header="_Whitespace">
          <MenuItem Header="_Compare whitespace" ToggleType="Radio" Command="{Binding SetWhitespaceCommand}" CommandParameter="Compare"
                    IsChecked="{Binding Settings.Whitespace, Mode=OneWay, Converter={x:Static d:EqualityConverters.EqualsParameter}, ConverterParameter=Compare}" />
          <MenuItem Header="Ignore _trailing whitespace" ToggleType="Radio" Command="{Binding SetWhitespaceCommand}" CommandParameter="IgnoreTrailing"
                    IsChecked="{Binding Settings.Whitespace, Mode=OneWay, Converter={x:Static d:EqualityConverters.EqualsParameter}, ConverterParameter=IgnoreTrailing}" />
          <MenuItem Header="Ignore whitespace _changes" ToggleType="Radio" Command="{Binding SetWhitespaceCommand}" CommandParameter="IgnoreChanges"
                    IsChecked="{Binding Settings.Whitespace, Mode=OneWay, Converter={x:Static d:EqualityConverters.EqualsParameter}, ConverterParameter=IgnoreChanges}" />
          <MenuItem Header="Ignore _all whitespace" ToggleType="Radio" Command="{Binding SetWhitespaceCommand}" CommandParameter="IgnoreAll"
                    IsChecked="{Binding Settings.Whitespace, Mode=OneWay, Converter={x:Static d:EqualityConverters.EqualsParameter}, ConverterParameter=IgnoreAll}" />
        </MenuItem>
        <MenuItem Header="Ignore _Case" ToggleType="CheckBox" Command="{Binding ToggleIgnoreCaseCommand}" IsChecked="{Binding Settings.IgnoreCase, Mode=OneWay}" />
        <MenuItem Header="Ignore _Blank Lines" ToggleType="CheckBox" Command="{Binding ToggleIgnoreBlankLinesCommand}" IsChecked="{Binding Settings.IgnoreBlankLines, Mode=OneWay}" />
      </MenuItem>
      <MenuItem Header="_Merge">
        <MenuItem Header="_Previous Unresolved Conflict" InputGesture="Ctrl+PageUp" Command="{Binding PreviousConflictCommand}" />
        <MenuItem Header="_Next Unresolved Conflict" InputGesture="Ctrl+PageDown" Command="{Binding NextConflictCommand}" />
        <Separator />
        <MenuItem Header="Choose _A (base)" InputGesture="Ctrl+D1" Command="{Binding ChooseACommand}" />
        <MenuItem Header="Choose _B (local)" InputGesture="Ctrl+D2" Command="{Binding ChooseBCommand}" />
        <MenuItem Header="Choose _C (remote)" InputGesture="Ctrl+D3" Command="{Binding ChooseCCommand}" />
        <MenuItem Header="Choose B then C" Command="{Binding ChooseBThenCCommand}" />
        <MenuItem Header="Choose C then B" Command="{Binding ChooseCThenBCommand}" />
        <MenuItem Header="_Unresolve" Command="{Binding UnresolveCommand}" />
        <Separator />
        <MenuItem Header="Auto-_merge All" InputGesture="Ctrl+Shift+M" Command="{Binding AutoMergeAllCommand}" />
        <MenuItem Header="Resolve All Remaining With">
          <MenuItem Header="A (base)" Command="{Binding ResolveAllCommand}" CommandParameter="A" />
          <MenuItem Header="B (local)" Command="{Binding ResolveAllCommand}" CommandParameter="B" />
          <MenuItem Header="C (remote)" Command="{Binding ResolveAllCommand}" CommandParameter="C" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Theme">
          <MenuItem Header="_System" ToggleType="Radio" Command="{Binding SetThemeCommand}" CommandParameter="System"
                    IsChecked="{Binding Settings.Theme, Mode=OneWay, Converter={x:Static d:EqualityConverters.EqualsParameter}, ConverterParameter=System}" />
          <MenuItem Header="_Light" ToggleType="Radio" Command="{Binding SetThemeCommand}" CommandParameter="Light"
                    IsChecked="{Binding Settings.Theme, Mode=OneWay, Converter={x:Static d:EqualityConverters.EqualsParameter}, ConverterParameter=Light}" />
          <MenuItem Header="_Dark" ToggleType="Radio" Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                    IsChecked="{Binding Settings.Theme, Mode=OneWay, Converter={x:Static d:EqualityConverters.EqualsParameter}, ConverterParameter=Dark}" />
        </MenuItem>
        <MenuItem Header="Colour-blind Safe _Palette" ToggleType="CheckBox" Command="{Binding TogglePaletteCommand}"
                  IsChecked="{Binding Settings.Palette, Mode=OneWay, Converter={x:Static d:EqualityConverters.EqualsParameter}, ConverterParameter=ColorBlind}" />
        <Separator />
        <MenuItem Header="_Font">
          <MenuItem Header="_Larger" InputGesture="Ctrl+OemPlus" Command="{Binding ZoomFontCommand}" CommandParameter="+" />
          <MenuItem Header="_Smaller" InputGesture="Ctrl+OemMinus" Command="{Binding ZoomFontCommand}" CommandParameter="-" />
          <MenuItem Header="_Reset" InputGesture="Ctrl+D0" Command="{Binding ZoomFontCommand}" CommandParameter="0" />
          <Separator />
          <MenuItem Header="Font _Family" x:Name="FontFamilyMenu" />
        </MenuItem>
        <MenuItem Header="Tab _Size">
          <MenuItem Header="2" ToggleType="Radio" Command="{Binding SetTabSizeCommand}" CommandParameter="2"
                    IsChecked="{Binding Settings.TabSize, Mode=OneWay, Converter={x:Static d:EqualityConverters.EqualsParameter}, ConverterParameter=2}" />
          <MenuItem Header="4" ToggleType="Radio" Command="{Binding SetTabSizeCommand}" CommandParameter="4"
                    IsChecked="{Binding Settings.TabSize, Mode=OneWay, Converter={x:Static d:EqualityConverters.EqualsParameter}, ConverterParameter=4}" />
          <MenuItem Header="8" ToggleType="Radio" Command="{Binding SetTabSizeCommand}" CommandParameter="8"
                    IsChecked="{Binding Settings.TabSize, Mode=OneWay, Converter={x:Static d:EqualityConverters.EqualsParameter}, ConverterParameter=8}" />
        </MenuItem>
        <MenuItem Header="_Word Wrap" ToggleType="CheckBox" Command="{Binding ToggleWordWrapCommand}" IsChecked="{Binding Settings.WordWrap, Mode=OneWay}" />
        <MenuItem Header="Show _Whitespace" ToggleType="CheckBox" Command="{Binding ToggleShowWhitespaceCommand}" IsChecked="{Binding Settings.ShowWhitespace, Mode=OneWay}" />
        <MenuItem Header="Line _Numbers" ToggleType="CheckBox" Command="{Binding ToggleLineNumbersCommand}" IsChecked="{Binding Settings.ShowLineNumbers, Mode=OneWay}" />
        <MenuItem Header="S_ynchronized Scrolling" ToggleType="CheckBox" Command="{Binding ToggleSyncScrollingCommand}" IsChecked="{Binding IsSyncScrolling, Mode=OneWay}" />
        <Separator />
        <MenuItem Header="_Assistants Panel" ToggleType="CheckBox" Command="{Binding ToggleAssistantsPanelCommand}" IsChecked="{Binding IsAssistantsPanelVisible, Mode=OneWay}" />
      </MenuItem>
      <MenuItem Header="_Plugins" x:Name="PluginsMenu" />
      <MenuItem Header="_Help">
        <MenuItem Header="_Command Line…" x:Name="HelpCommandLine" />
        <MenuItem Header="_Git Integration…" x:Name="HelpGit" />
        <Separator />
        <MenuItem Header="_About DiffWeave" x:Name="HelpAbout" />
      </MenuItem>
    </Menu>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource DW.Toolbar.Background}" BorderBrush="{DynamicResource DW.Pane.Border}"
            BorderThickness="0,0,0,1" Padding="6,3">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tool" Command="{Binding OpenFilesDialogCommand}" ToolTip.Tip="Compare files (Ctrl+O)" AutomationProperties.Name="Open">
          <PathIcon Data="M2 4.5A1.5 1.5 0 0 1 3.5 3h4l1.5 2h7.5A1.5 1.5 0 0 1 18 6.5V8H2V4.5ZM2 9h16l-1.4 7.4A1.5 1.5 0 0 1 15.1 17.6H3.5A1.5 1.5 0 0 1 2 16.1V9Z" />
        </Button>
        <Button Classes="tool" Command="{Binding SaveCommand}" ToolTip.Tip="Save merge result (Ctrl+S)" AutomationProperties.Name="Save">
          <PathIcon Data="M3 2h11l4 4v12H2V2Zm3 1v5h8V3Zm-1 9v5h10v-5Z" />
        </Button>
        <Border Classes="sep" />
        <Button Classes="tool" Command="{Binding PreviousDifferenceCommand}" ToolTip.Tip="Previous difference (Ctrl+Up)" AutomationProperties.Name="Previous difference">
          <PathIcon Data="M10 4l7 8h-4.5v5h-5v-5H3Z" />
        </Button>
        <Button Classes="tool" Command="{Binding NextDifferenceCommand}" ToolTip.Tip="Next difference (Ctrl+Down)" AutomationProperties.Name="Next difference">
          <PathIcon Data="M10 17l7-8h-4.5V4h-5v5H3Z" />
        </Button>
        <Border Classes="sep" IsVisible="{Binding IsMerge}" />
        <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsMerge}" x:Name="MergeToolbar">
          <Button Classes="tool" Command="{Binding PreviousConflictCommand}" ToolTip.Tip="Previous unresolved conflict (Ctrl+PgUp)" AutomationProperties.Name="Previous conflict">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Data="M10 4l7 8h-4.5v5h-5v-5H3Z" Foreground="{DynamicResource DW.Kind.Conflict.Mark}" />
              <TextBlock Text="Conflict" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding NextConflictCommand}" ToolTip.Tip="Next unresolved conflict (Ctrl+PgDn)" AutomationProperties.Name="Next conflict">
            <PathIcon Data="M10 17l7-8h-4.5V4h-5v5H3Z" Foreground="{DynamicResource DW.Kind.Conflict.Mark}" />
          </Button>
          <Border Classes="sep" />
          <TextBlock Text="Choose" FontSize="12" VerticalAlignment="Center" Margin="4,0,2,0" Foreground="{DynamicResource DW.Subtle}" />
          <Button Classes="tool" Command="{Binding ChooseACommand}" ToolTip.Tip="Choose A — base (Ctrl+1, or A)" AutomationProperties.Name="Choose A">
            <Border Classes="badge" Background="{DynamicResource DW.Badge.A}"><TextBlock Text="A" /></Border>
          </Button>
          <Button Classes="tool" Command="{Binding ChooseBCommand}" ToolTip.Tip="Choose B — local (Ctrl+2, or B)" AutomationProperties.Name="Choose B">
            <Border Classes="badge" Background="{DynamicResource DW.Badge.B}"><TextBlock Text="B" /></Border>
          </Button>
          <Button Classes="tool" Command="{Binding ChooseCCommand}" ToolTip.Tip="Choose C — remote (Ctrl+3, or C)" AutomationProperties.Name="Choose C">
            <Border Classes="badge" Background="{DynamicResource DW.Badge.C}"><TextBlock Text="C" /></Border>
          </Button>
          <Button Classes="tool" Command="{Binding ChooseBThenCCommand}" ToolTip.Tip="Take B's lines followed by C's" AutomationProperties.Name="Choose B then C">
            <TextBlock Text="B+C" FontSize="12" FontWeight="SemiBold" />
          </Button>
          <Button Classes="tool" Command="{Binding ChooseCThenBCommand}" ToolTip.Tip="Take C's lines followed by B's" AutomationProperties.Name="Choose C then B">
            <TextBlock Text="C+B" FontSize="12" FontWeight="SemiBold" />
          </Button>
          <Border Classes="sep" />
          <Button Classes="tool" Command="{Binding AutoMergeAllCommand}" ToolTip.Tip="Merge all non-conflicting changes automatically (Ctrl+Shift+M)" AutomationProperties.Name="Auto-merge">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <PathIcon Data="M4 3v6a4 4 0 0 0 4 4h5M16 3v4M13 10l3 3-3 3" />
              <TextBlock Text="Auto-merge" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding UnresolveCommand}" ToolTip.Tip="Mark the current region unresolved" AutomationProperties.Name="Unresolve">
            <TextBlock Text="Unresolve" FontSize="12" />
          </Button>
        </StackPanel>
        <Border Classes="sep" />
        <Button Classes="tool" Command="{Binding FindCommand}" ToolTip.Tip="Find (Ctrl+F)" AutomationProperties.Name="Find">
          <PathIcon Data="M8.5 2a6.5 6.5 0 0 1 5.2 10.4l4.4 4.4-1.4 1.4-4.4-4.4A6.5 6.5 0 1 1 8.5 2Zm0 2a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Z" />
        </Button>
        <ToggleButton Classes="tool" IsChecked="{Binding IsAssistantsPanelVisible}" ToolTip.Tip="Show the merge assistants panel"
                      AutomationProperties.Name="Assistants panel" Background="Transparent" BorderThickness="0" Padding="7,4">
          <PathIcon Width="14" Height="14" Data="M10 1l2.2 5.3L18 7l-4.4 3.9L15 17l-5-3-5 3 1.4-6.1L2 7l5.8-.7Z" />
        </ToggleButton>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource DW.Status.Background}" BorderBrush="{DynamicResource DW.Pane.Border}"
            BorderThickness="0,1,0,0" Padding="10,3" Height="26">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="18">
          <TextBlock Classes="status" Text="{Binding DifferenceStatus}" x:Name="DifferenceStatusText" />
          <TextBlock Classes="status" Text="{Binding ConflictStatus}" x:Name="ConflictStatusText" FontWeight="SemiBold"
                     IsVisible="{Binding IsMerge}" />
          <TextBlock Classes="status" Text="{Binding CaretStatus}" MinWidth="90" />
        </StackPanel>
        <TextBlock Classes="status" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" x:Name="StatusMessageText" />
      </DockPanel>
    </Border>

    <!-- Changed on disk -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasChangedOnDisk}" Background="{DynamicResource DW.Info.Background}"
            BorderBrush="{DynamicResource DW.Info.Border}" BorderThickness="0,0,0,1" Padding="10,5">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Content="Reload" Classes="accent" Command="{Binding ReloadCommand}" />
          <Button Content="Ignore" Command="{Binding DismissChangedOnDiskCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding ChangedOnDiskMessage}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Find / go to line -->
    <Border DockPanel.Dock="Top" x:Name="FindBar" IsVisible="False" Background="{DynamicResource DW.Toolbar.Background}"
            BorderBrush="{DynamicResource DW.Pane.Border}" BorderThickness="0,0,0,1" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBox x:Name="FindText" Width="280" PlaceholderText="Find" AutomationProperties.Name="Find text" />
        <Button x:Name="FindPrevButton" Content="Previous" ToolTip.Tip="Shift+Enter / Shift+F3" />
        <Button x:Name="FindNextButton" Content="Next" ToolTip.Tip="Enter / F3" />
        <CheckBox x:Name="FindCase" Content="Match case" />
        <CheckBox x:Name="FindRegex" Content="Regex" />
        <CheckBox x:Name="FindWord" Content="Whole word" />
        <Button x:Name="FindClose" Classes="tool" ToolTip.Tip="Close (Esc)" AutomationProperties.Name="Close find bar">
          <PathIcon Width="10" Height="10" Data="M2.3 1L5 3.7L7.7 1L9 2.3L6.3 5L9 7.7L7.7 9L5 6.3L2.3 9L1 7.7L3.7 5L1 2.3Z" />
        </Button>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" x:Name="GoToBar" IsVisible="False" Background="{DynamicResource DW.Toolbar.Background}"
            BorderBrush="{DynamicResource DW.Pane.Border}" BorderThickness="0,0,0,1" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Go to line" VerticalAlignment="Center" />
        <TextBox x:Name="GoToText" Width="120" PlaceholderText="Line number" AutomationProperties.Name="Line number" />
        <Button x:Name="GoToButton" Content="Go" Classes="accent" />
        <Button x:Name="GoToClose" Classes="tool" AutomationProperties.Name="Close go to line">
          <PathIcon Width="10" Height="10" Data="M2.3 1L5 3.7L7.7 1L9 2.3L6.3 5L9 7.7L7.7 9L5 6.3L2.3 9L1 7.7L3.7 5L1 2.3Z" />
        </Button>
      </StackPanel>
    </Border>

    <Grid x:Name="ContentGrid" ColumnDefinitions="*,Auto,Auto" Margin="6,4,6,6">
      <TabControl x:Name="Tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0" Margin="0">
        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DocumentTab">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center" />
              <Button Classes="tool" Padding="3" MinHeight="16" ToolTip.Tip="Close tab (Ctrl+W)"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding}">
                <PathIcon Width="8" Height="8" Data="M2.3 1L5 3.7L7.7 1L9 2.3L6.3 5L9 7.7L7.7 9L5 6.3L2.3 9L1 7.7L3.7 5L1 2.3Z" />
              </Button>
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate x:DataType="vm:DocumentTab">
            <ContentControl Content="{Binding Content}" />
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" IsVisible="{Binding IsAssistantsPanelVisible}" />
      <v:AssistantsPanel Grid.Column="2" x:Name="AssistantsPanelView" Width="340" DataContext="{Binding Assistants}"
                         IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsAssistantsPanelVisible}" />
    </Grid>
  </DockPanel>
</Window>
