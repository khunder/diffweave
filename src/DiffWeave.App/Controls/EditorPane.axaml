<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:DiffWeave.App.Controls"
             x:Class="DiffWeave.App.Controls.EditorPane">
  <Border BorderBrush="{DynamicResource DW.Pane.Border}" BorderThickness="1" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
      <Border x:Name="PartHeader" Grid.ColumnSpan="2" Background="{DynamicResource DW.Pane.HeaderBackground}"
              BorderBrush="{DynamicResource DW.Pane.Border}" BorderThickness="0,0,0,1" Padding="6,4">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <Border x:Name="PartBadge" CornerRadius="4" MinWidth="22" Height="20" Padding="5,0" VerticalAlignment="Center"
                  Background="{DynamicResource DW.Badge.A}">
            <TextBlock x:Name="PartBadgeText" Text="A" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource DW.Badge.Foreground}" />
          </Border>
          <StackPanel Grid.Column="1" Orientation="Vertical" Margin="8,0,6,0" VerticalAlignment="Center">
            <TextBlock x:Name="PartTitleText" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource DW.Pane.HeaderForeground}" />
            <TextBlock x:Name="PartPathText" FontSize="11" TextTrimming="PathSegmentEllipsis"
                       Foreground="{DynamicResource DW.Pane.HeaderSubtle}" />
          </StackPanel>
          <TextBlock x:Name="PartInfoText" Grid.Column="2" FontSize="11" VerticalAlignment="Center" Margin="4,0,8,0"
                     Foreground="{DynamicResource DW.Pane.HeaderSubtle}" />
          <Button x:Name="PartOpenButton" Grid.Column="3" Padding="6,2" VerticalAlignment="Center" Classes="pane-open"
                  ToolTip.Tip="Open a different file in this pane">
            <PathIcon Width="14" Height="14" Data="M2 4.5A1.5 1.5 0 0 1 3.5 3h4l1.5 2h7.5A1.5 1.5 0 0 1 18 6.5V8H2V4.5ZM2 9h16l-1.4 7.4A1.5 1.5 0 0 1 15.1 17.6H3.5A1.5 1.5 0 0 1 2 16.1V9Z" />
          </Button>
        </Grid>
      </Border>
      <c:DiffTextView x:Name="PartView" Grid.Row="1" />
      <ScrollBar x:Name="PartVScroll" Grid.Row="1" Grid.Column="1" Orientation="Vertical" AllowAutoHide="False" />
      <ScrollBar x:Name="PartHScroll" Grid.Row="2" Orientation="Horizontal" AllowAutoHide="False" />
    </Grid>
  </Border>
</UserControl>
